@ extends: CMS_list

static sortColumn($model) => property_exists($model, 'sortColumn') ? $model::$sortColumn : 'sort'
static sortGroup($model) => property_exists($model, 'sortGroup') ? $model::$sortGroup : null

static sortIds($model, array $ids) => array_values(array_map(fn($id) => $model::$idType === 'int' ? (int)$id : (string)$id, $ids))

static sortGroupOf($record, $group) => $record->objData[$group] ?? $record->$group

// An empty group is a group of its own: records without a category belong together and can
// be ordered among themselves. That needs IS NULL, because an equality bind on null matches
// nothing in SQL and would silently hand back an empty group.
static sortGroupRecords($model, $record, $column, $group){
	if ($group === null) return $model::records(order: $column.' ASC')
	$value = static::sortGroupOf($record, $group)
	if ($value === null) return $model::records(where: $group.' IS NULL', order: $column.' ASC')
	return $model::records(...[$group => $value], order: $column.' ASC')
}

// The next free position within the record's own group, so a new record lands at the end
// instead of jumping to the front on a sort column that defaults to zero.
static sortNext($model, $record):int {
	$column = static::sortColumn($model)
	$group = static::sortGroup($model)
	$rows = static::sortGroupRecords($model, $record, $column, $group)
	$last = 0
	foreach ($rows AS $row) $last = max($last, (int)$row->$column)
	return $last + 1
}

route async PUT api sort $model @ids {
	if (!%CSRF->verify) return apply(error: 'Invalid CSRF token')
	if (!in_array($model, (array)%app->models, true)) return apply(error: 'Unknown model')
	if ((property_exists($model, 'listView') ? $model::$listView : null) !== 'sort') return apply(error: 'Model does not sort by hand')
	$column = static::sortColumn($model)
	$fields = $model::fields()
	if (!isset($fields[$column])) return apply(error: 'Model has no sort column')
	$group = static::sortGroup($model)
	if ($group !== null && !isset($fields[$group])) return apply(error: 'Model has no sort group')
	$key = $model::idColumn()
	$ids = static::sortIds($model, (array)%payload->ids)
	if (!$ids) return apply(error: 'Nothing to sort')
	if (count($ids) !== count(array_unique($ids, SORT_REGULAR))) return apply(error: 'Duplicate records')
	$first = $model::record(...[$key => $ids[0]])
	if (!$first) return apply(error: 'Unknown record')
	$all = static::sortGroupRecords($model, $first, $column, $group)
	foreach ($ids AS $id) if (!isset($all[$id])) return apply(error: 'Record outside this group')
	$order = array_keys($all)
	$slots = []
	foreach ($order AS $index => $id) if (in_array($id, $ids, true)) $slots[] = $index
	foreach ($slots AS $slot => $index) $order[$index] = $ids[$slot]
	// Renumbering normalises the whole group, so it writes records the browser never sent.
	// Permission is therefore checked over everything that actually changes, not over what
	// was submitted: a record the user may not change must not be moved by dragging its
	// neighbour either.
	$writes = []
	foreach ($order AS $index => $id) if ((int)$all[$id]->$column !== $index + 1) $writes[$id] = $index + 1
	foreach ($writes AS $id => $position) if (!$model::canChange($all[$id])) return apply(error: 'Not allowed')
	$model::transaction(function() use ($model, $writes, $column, $key){
		foreach ($writes AS $id => $position) $model::change($key.'=?', $id, ...[$column => $position])
	})
	return apply(state: false)
}

prop fieldCount => count($this->fields) + 1

method sortGroupValue($record) => ($group = static::sortGroup($this->model)) ? (string)static::sortGroupOf($record, $group) : void

$this->type = 'default'

view body:
<table.body>
	<thead>
		<tr>
			<th></th>
			<foreach $this->fields AS $column => $field>
				<th>$field->title</th>
			</foreach>
		</tr>
	</thead>
	<tbody>
		{{ $this->bodyRecords }}
	</tbody>
</table>
{( $this->parent ? void : $this->more )}

view bodyRecords:
<if $records = $this->records>
	<foreach $this->records AS $id => $record>
		<tr data-id=$id data-sort-group="{[ $this->sortGroupValue($record) ]}">
			{( $this->o ? '<td class="sort sort--off" title="'.esc(en('Switch back to the manual order to drag')).'">⬍</td>' : '<td class="sort" title="'.esc(en('Drag to reorder')).'">⬍</td>' )}
			<foreach $this->fields AS $column => $field>
				{{ $this->field($field, $record, 'td') }}
			</foreach>
		</tr>
	</foreach>
<else>
	{{ $this->noRecords }}
</if>

<script>
let draggingRow = null
let dragStartOrder = null
let dragTbody = null

const getOrder = tbody => [...tbody.querySelectorAll('tr[data-id]')].map(tr => tr.dataset.id)
const sameGroup = (a, b) => a.dataset.sortGroup === b.dataset.sortGroup
const arraysEqual = (a, b) => a.length === b.length && a.every((v, i) => v === b[i])

on('pointerdown', 'td.sort', (cell, e) => {
	const tr = cell.closest('tr')
	if (!tr || e.button !== 0 || cell.classList.contains('sort--off')) return false
	e.preventDefault()
	draggingRow = tr
	dragTbody = tr.parentNode
	dragStartOrder = getOrder(dragTbody)
	tr.classList.add('dragging')
	return false
})

on('pointermove', 'body', (body, e) => {
	if (!draggingRow) return false
	const tr = e.target.closest('tr')
	if (!tr || tr.parentNode !== dragTbody || !sameGroup(tr, draggingRow)) return false
	const rect = tr.getBoundingClientRect()
	const offset = e.clientY - rect.top
	if (offset < rect.height / 2) dragTbody.insertBefore(draggingRow, tr)
	else dragTbody.insertBefore(draggingRow, tr.nextElementSibling)
	return false
})

on('pointerup', 'body', (body, e) => {
	if (!draggingRow) return false
	draggingRow.classList.remove('dragging')
	if (dragTbody && dragStartOrder){
		const newOrder = getOrder(dragTbody)
		if (!arraysEqual(dragStartOrder, newOrder)){
			const group = draggingRow.dataset.sortGroup
			const ids = [...dragTbody.querySelectorAll('tr[data-id]')].filter(tr => tr.dataset.sortGroup === group).map(tr => tr.dataset.id)
			app.put(`api/sort/${draggingRow.closest('[data-model]').dataset.model}`, {ids})
		}
	}
	draggingRow = null
	dragTbody = null
	dragStartOrder = null
	return false
})
</script>

<style>
td.sort--off {
	cursor: default
	opacity: .25
}
td.sort {
	cursor: grab
	font-size: 2em
	text-align: center
	touch-action: none
	user-select: none
	vertical-align: middle !important
}
tbody:has(tr.dragging) tr:not(.dragging): opacity: .3
</style>
