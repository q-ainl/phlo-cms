route both GET $list $token {
	if (str_contains($token, eq)) return false
	if (!$model = CMS::uriListFind($list)) return false
	$this->fromBI(token: $token)
}
route async POST bi @q {
	trim(%payload->q) || error('Describe what you are looking for')
	if (($search = array_filter(loop($this->searches->objData, fn($search, $token) => $search['title'] === %payload->q && ($search['v'] ?? null) === $this->promptVersion ? $search : null))) && ($token = key($search))) return $this->fromBI($search[$token], $token)
	$token = token(input: %payload->q)
	$res = $this->searches->$token
	if (($res['v'] ?? null) !== $this->promptVersion) $res = null
	$res ??= $this->ask((string)%payload->q, $token)
	if ($res === null) return $this->fail('Could not understand that query')
	$this->pruneCache()
	$this->fromBI($res, $token)
}

// Apart from the route so a stored answer that predates a correction can replace itself: its own
// address is a link people keep.
method ask($question, $token){
	$parsed = array_filter((array)json_decode(%AI->chat(model: $this->model, user: $this->prompt(loop(%app->models, fn($model) => "Model: $model\nColumns: ".$this->promptColumns($model), lf.lf), $question), temperature: 0, response_format: arr(type: 'json_object'))->answer, true))
	if (!in_array($parsed['model'] ?? null, %app->models, true)) return null
	$parsed['v'] = $this->promptVersion
	$parsed['title'] ??= $question
	return $this->searches->$token = $parsed
}

method pruneCache($max = 200){
	$data = $this->searches->objData
	if (count($data) <= $max) return
	uasort($data, fn($a, $b) => ($a['usage'] ?? 0) <=> ($b['usage'] ?? 0))
	foreach (array_slice(array_keys($data), 0, count($data) - $max) AS $key) unset($this->searches->$key)
	$this->searches->objChanged = true
}

prop searches => %JSON('bi', assoc: true)

method fromBI($res = null, $token = null){
	$res ??= first($this->searches->$token, $this->searches->$token['usage'] = ($this->searches->$token['usage'] ?? 0) + 1, $this->searches->objChanged = true)
	// Checked here and not only where a question is asked: a stored answer is also reached by its own
	// address, and opening that link replayed what was written before a correction.
	if ($res && ($res['v'] ?? null) !== $this->promptVersion){
		// The model can be unreachable; then the stale answer still goes and the reader hears why.
		try {
			$again = $token ? $this->ask((string)($res['title'] ?? void), $token) : null
		} catch (\Throwable $e){
			$again = null
		}
		if ($again === null){
			if ($token && isset($this->searches->$token)){
				unset($this->searches->$token)
				$this->searches->objChanged = true
			}
			return $this->fail(en('That answer was written before this search was improved. Ask the question again.'))
		}
		$res = $again
	}
	$model = $res['model'] ?? null
	if (!$model || !in_array($model, %app->models)) return $this->fail('Could not understand that query')
	if (!$model::canView()) return $this->fail('No access to that data')
	%app->active = $model
	$title = (string)($res['title'] ?? $model)
	$uri = ($model::$uriList ?? $model::$table).slash.$token
	try {
		if (isset($res['aggregate'])) return $this->renderAggregate($model, $res, $this->buildAggregate($model, $res), $title, $uri)
		$records = $this->buildClauses($model, $res)
	} catch (\Throwable $e){
		// The model was valid but the structure (column/operator) was not; drop it from the cache so the
		// same deterministic token does not fail forever and is re-asked next time.
		if ($token && isset($this->searches->$token)){
			unset($this->searches->$token)
			$this->searches->objChanged = true
		}
		return $this->fail('That query could not be run')
	}
	$CMS = CMS($model, 'list', records: $records)
	$CMS->title = esc($title)
	main($CMS, $title, path: "$CMS->uri/$token")
}

// One reading of "grouped", shared with buildAggregate: reading it differently here showed the
// first of several groups as a single total, which is a wrong report that looks like a right one.
method grouping($res) => (string)($res['group'] ?? $res['groupBy'] ?? '')

// The chart widget renders only when the widget resource is loaded (a CMS app need not enable it), so the
// data table stays as a fallback that needs neither the widget nor echarts.
method renderAggregate($model, $res, $rows, $title, $uri){
	if ($this->grouping($res) === '') return main($this->statCard($title, $rows[0]['value'] ?? 0), $title, path: $uri)
	$data = []
	foreach ($rows AS $row) $data[(string)($row['label'] ?? '')] = $row['value']
	$type = in_array($res['chart'] ?? 'bar', ['bar', 'line', 'pie'], true) ? $res['chart'] : 'bar'
	$chart = $data && phlo_exists('widget_'.$type) ? tag('div', tag('figure', tag('figcaption', esc($title)).phlo('widget_'.$type, type: $type, data: $data)->view), id: 'widgets') : void
	$chart && %app->js = '/chart.js'
	return main($chart.$this->dataTable($data), $title, path: $uri)
}

method statCard($title, $value) => tag('div', tag('div', $this->formatValue($value), class: 'bi-stat-value').tag('div', esc($title), class: 'bi-stat-label'), class: 'bi-stat')

method dataTable($data){
	$rows = loop($data, fn($value, $label) => tag('tr', tag('td', esc((string)$label)).tag('td', $this->formatValue($value))), lf)
	return tag('table', tag('tbody', indentView(lf.$rows.lf)), class: 'bi-table')
}

method formatValue($value) => is_numeric($value) && $value == (int)$value ? number_format((int)$value) : esc((string)$value)

// Real (DB-backed) column names of a model, used both to brief the LLM and to validate its choices.
method modelColumns($model){
	$cols = []
	foreach ($model::fields() AS $field) foreach ((array)$field->objColumns AS $col) $cols[$col] = true
	return array_keys($cols)
}

// Tag each column with its human title so the model knows what it holds (an `id` titled "Domain" is a domain
// name, not a technical key), and mark date columns so it answers with a plain date string.
method promptColumns($model){
	$meta = []
	foreach ($model::fields() AS $column => $field) foreach ((array)$field->objColumns AS $col) $meta[$col] ??= $field
	return loop($this->modelColumns($model), fn($col) => $col.$this->columnNote($meta[$col] ?? null, $model, $col), ', ')
}
method columnNote($field, $model = null, $column = null){
	$title = $field && $field->title && strtolower((string)$field->title) !== strtolower((string)$field->name) ? (string)$field->title : void
	// A unix timestamp needs FROM_UNIXTIME, a real DATE column must not have it: wrapping the second
	// kind returns nothing while looking like an answer. The storage is asked of the database.
	$stored = $this->columnType($model, $column)
	$isDate = in_array($stored, ['date', 'datetime', 'timestamp'], true)
	$note = $isDate ? 'date' : ($field && in_array($field->type, ['date', 'datetime'], true) ? 'unix timestamp' : void)
	// A pointer is not the thing it is named after: "day" on a sale is an id, not a date.
	if ($note === void && $field && $field->type === 'parent') $note = 'id of another record, join to read its fields'
	return $title || $note ? ' ('.implode(comma.space, array_filter([$title, $note])).')' : void
}

// Asked of the database rather than the model, because this is about storage and not about how the
// field presents itself. Cached per table: the prompt walks every column of every model.
method columnType($model, $column){
	if (!$model || !$column) return void
	$table = (string)($model::$table ?? void)
	if ($table === void) return void
	%req->biTypes ??= []
	if (!isset(%req->biTypes[$table])){
		$types = []
		try {
			foreach ($model::DB()->query('SELECT COLUMN_NAME, DATA_TYPE FROM information_schema.COLUMNS WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = ?', $table)->fetchAll(\PDO::FETCH_NUM) AS $row) $types[(string)$row[0]] = (string)$row[1]
		} catch (\Throwable $e){
		}
		%req->biTypes = [...%req->biTypes, $table => $types]
	}
	return strtolower((string)(%req->biTypes[$table][$column] ?? void))
}

method aggregates => ['count' => 'COUNT', 'sum' => 'SUM', 'avg' => 'AVG', 'min' => 'MIN', 'max' => 'MAX']

// Raise this whenever the instructions change: a stored answer written under the old ones is then
// asked again instead of being replayed forever. Writing SQL is not the job the app-wide default
// model is set for, so this search names its own and leaves translations where they are.
prop model:string = 'gpt-5.4-mini'

method promptVersion => 7

// Spelled out with chr(37) because a percent sign followed by a name is a resource reference in
// this language, so writing the format string literally turns '%Y-%m' into two lookups.
method monthFormat => "DATE_FORMAT(FROM_UNIXTIME(column), '".chr(37)."Y-".chr(37)."m')"

// The WHERE clause the LLM's STRUCTURED filters translate to, shared by the list and the aggregate query. Every
// column is validated against the model's real columns and identifier-quoted, every value is a bound (?)
// parameter, and the operator comes from a closed allowlist. No LLM text ever reaches the SQL string, so
// injection (UNION etc.) is impossible; an unknown column/operator throws -> fromBI catches -> fail().
method whereParts($model, $res, $valid, $qcol){
	$ops = ['=' => '=', '!=' => '!=', '<>' => '!=', '>' => '>', '>=' => '>=', '<' => '<', '<=' => '<=', 'like' => 'LIKE']
	$dateCols = array_flip(array_filter(loop($model::fields(), fn($field, $column) => in_array($field->type, ['date', 'datetime'], true) ? $column : null)))
	$scalar = fn($col, $value) => is_array($value) ? $this->coerceValue($col, reset($value), $dateCols) : $this->coerceValue($col, $value, $dateCols)
	$conds = []
	$binds = []
	foreach ((array)($res['filters'] ?? []) AS $f){
		$col = (string)($f['column'] ?? '')
		isset($valid[$col]) || error("Unknown column: $col")
		$op = strtolower((string)($f['op'] ?? '='))
		$qc = $qcol($col)
		if ($op === 'null') $conds[] = "$qc IS NULL"
		elseif ($op === 'notnull') $conds[] = "$qc IS NOT NULL"
		elseif ($op === 'in'){
			($vals = array_values((array)($f['value'] ?? []))) || error('in needs values')
			$conds[] = "$qc IN (".implode(comma, array_fill(0, count($vals), qm)).")"
			foreach ($vals AS $v) $binds[] = $this->coerceValue($col, $v, $dateCols)
		}
		elseif ($op === 'between'){
			count($vals = array_slice(array_values((array)($f['value'] ?? [])), 0, 2)) === 2 || error('between needs two values')
			$conds[] = "$qc BETWEEN ? AND ?"
			foreach ($vals AS $v) $binds[] = $this->coerceValue($col, $v, $dateCols)
		}
		elseif (isset($ops[$op])){
			$conds[] = "$qc $ops[$op] ?"
			$binds[] = $scalar($col, $f['value'] ?? null)
		}
		else error('Unknown operator')
	}
	return [$conds, $binds]
}

// The clauses as the model wrote them: a WHERE is an expression, so a weekday or a subquery fits.
// Reading is free; altering, creating and removing are not, and that is the whole line. OUTFILE
// and DUMPFILE write a file, LOAD_FILE reads one.
method clauseWords => ['insert', 'update', 'delete', 'replace', 'truncate', 'drop', 'alter', 'create', 'rename', 'grant', 'revoke', 'load_file', 'call', 'lock', 'unlock', 'handler', 'prepare', 'execute', 'outfile', 'dumpfile']

method clauseSafe($fragment){
	$text = (string)$fragment
	if ($text === void) return void
	if (preg_match('~/\*!~', $text)) error('A search cannot contain an executable comment')
	$clean = trim((string)preg_replace(['~/\*.*?\*/~s', '~--[^\n]*~', '~#[^\n]*~'], space, $text))
	if (str_contains($clean, ';')) error('A search cannot contain more than one statement')
	foreach ($this->clauseWords() AS $word){
		if (preg_match('~(?<![a-z0-9_])'.preg_quote($word, '~').'(?![a-z0-9_])~i', $clean)) error('A search cannot contain '.strtoupper($word))
	}
	return $clean === void ? void : $clean
}

method buildClauses($model, $res){
	$clauses = []
	foreach (['where', 'joins', 'order', 'group'] AS $part){
		$safe = $this->clauseSafe($res[$part] ?? void)
		if ($safe !== void) $clauses[$part] = $safe
	}
	$clauses['limit'] = min(500, max(1, (int)($res['limit'] ?? 100)))
	return $model::records(...$clauses)
}

method buildQuery($model, $res){
	$valid = array_flip($this->modelColumns($model))
	$fq = $model::DB()->fieldQuotes
	$qcol = fn($c) => $fq.str_replace($fq, $fq.$fq, (string)$c).$fq
	[$conds, $binds] = $this->whereParts($model, $res, $valid, $qcol)
	$table = $fq.$model::$table.$fq
	$sql = 'SELECT '.$table.dot.$qcol($model::idColumn()).' AS _, '.$table.'.* FROM '.$table
	$conds && $sql .= ' WHERE '.implode(' AND ', $conds)
	$order = $res['order'] ?? null
	$oc = $order ? (string)($order['column'] ?? '') : ''
	if ($oc !== '' && isset($valid[$oc])){
		$dir = strtoupper((string)($order['dir'] ?? 'ASC')) === 'DESC' ? 'DESC' : 'ASC'
		$sql .= ' ORDER BY '.$qcol($oc).space.$dir
	}
	$sql .= ' LIMIT '.min(500, max(1, (int)($res['limit'] ?? 100)))
	return $model::DB()->query($sql, ...$binds)->fetchAll(\PDO::FETCH_CLASS|\PDO::FETCH_UNIQUE, $model)
}

// The aggregate function and both columns run through the same allowlist as whereParts before reaching SQL.
method buildAggregate($model, $res){
	$valid = array_flip($this->modelColumns($model))
	$fq = $model::DB()->fieldQuotes
	$qcol = fn($c) => $fq.str_replace($fq, $fq.$fq, (string)$c).$fq
	$table = $fq.$model::$table.$fq
	$agg = strtolower((string)($res['aggregate'] ?? 'count'))
	isset($this->aggregates[$agg]) || error('Unknown aggregate')
	if ($agg === 'count') $valueSql = 'COUNT(*)'
	else {
		// A bare column of this model is qualified with its table; anything else is taken as the
		// expression it is, checked by the same reading-only rule as the other clauses. Demanding a
		// listed column here is what refused "line.gross" the moment a join brought it in, and any
		// sum over something computed.
		$col = (string)($res['aggregateColumn'] ?? '')
		$col === '' && error('Missing aggregate column')
		$valueSql = $this->aggregates[$agg].'('.(isset($valid[$col]) ? $table.dot.$qcol($col) : $this->clauseSafe($col)).')'
	}
	[$conds, $binds] = $this->whereParts($model, $res, $valid, $qcol)
	// The same clauses the record list gets, or a total counts the whole table while the question
	// asked about a Saturday. A join belongs here too: the thing being counted and the thing being
	// filtered on often live in different tables.
	$where = $this->clauseSafe($res['where'] ?? void)
	$joins = $this->clauseSafe($res['joins'] ?? void)
	$where !== void && $conds[] = '('.$where.')'
	$group = $this->grouping($res)
	$groupSql = $group === '' ? void : (isset($valid[$group]) ? $table.dot.$qcol($group) : $this->clauseSafe($group))
	$sql = 'SELECT '.($groupSql !== void ? $groupSql.' AS '.$qcol('label').comma.space : void).$valueSql.' AS '.$qcol('value').' FROM '.$table
	$joins !== void && $sql .= space.$joins
	$conds && $sql .= ' WHERE '.implode(' AND ', $conds)
	if ($groupSql !== void) $sql .= ' GROUP BY '.$groupSql.' ORDER BY '.$qcol('value').' DESC LIMIT '.min(50, max(1, (int)($res['limit'] ?? 20)))
	return $model::DB()->query($sql, ...$binds)->fetchAll(\PDO::FETCH_ASSOC)
}

// A date column stores a unix timestamp but the model answers with a date string; convert it so the bound
// parameter matches the stored integer.
method coerceValue($col, $value, $dateCols){
	if (is_array($value)) return $value
	if (isset($dateCols[$col]) && is_string($value) && !is_numeric($value) && ($ts = strtotime($value)) !== false) return $ts
	return $value
}

method fail($message) => %req->async ? apply(error: $message) : main(tag('section', tag('h1', 'Search failed').tag('p', esc($message).dot)), 'Search failed')

view:
<form#bi.async action=/bi method=post autocomplete=off>
	<button#speak.icon.microphone type=button autofocus/>
	<input.field.full type=text name=q list=searches placeholder="{{ en('Describe what you want to know') }}">
	{{ $this->datalist }}
	<button>&gt;</button>
</form>

view datalist {
	$searches = array_filter($this->searches->objData, fn($s) => in_array($s['model'] ?? '', %app->models, true))
	uasort($searches, fn($a, $b) => ($b['usage'] ?? 0) <=> ($a['usage'] ?? 0))
	$options = loop($searches, fn($search, $token) => tag('option', value: $search['title'], data_uri: ($search['model']::$uriList ?? $search['model']::$table).slash.$token), lf)
	return tag('datalist', id: 'searches', inner: indentView("\n$options\n"))
}

view prompt($struct, $q):
You translate a natural-language question into a MySQL query over the structure below.
Return only a JSON object with these keys:
-title: a short title describing the search
-model: the singular model name, chosen from the list below
-where: optional, everything that would follow WHERE. Any expression is allowed, so use one where the question calls for it: DAYOFWEEK(), DATE_FORMAT(), BETWEEN, IN, a subquery.
-joins: optional, one or more JOIN clauses written out in full ("JOIN sale ON sale.id = line.sale"), for when the question filters on a column that lives in another table. Qualify columns with their table name as soon as you join.
-order: optional, everything that would follow ORDER BY
-group: optional, everything that would follow GROUP BY
-limit: optional integer, at most 500
-aggregate: optional, one of "count" "sum" "avg" "min" "max". Use this instead of the clauses above when the question asks for a single number ("how many", "total", "average") rather than for records.
-aggregateColumn: the column to sum/avg/min/max (omit for count)
-groupBy: optional, what to break that aggregate down by; with it the answer is a chart. Either a listed column, or the expression that produces the grouping - never a bare word for it. "Per month" is {{ $this->monthFormat }}, not "month"; per weekday is DAYOFWEEK(FROM_UNIXTIME(column)), not "weekday".
-chart: optional, one of "bar" "line" "pie", for a grouped aggregate
Use only the columns listed for the chosen model, and never invent one. Write the clauses in MySQL, not PostgreSQL: there is no DATE_TRUNC and no ILIKE.
Mind how a date column is stored, because the two kinds need different SQL and getting it wrong returns an empty answer that looks like a real one. A column marked (unix timestamp) is an integer: compare it with UNIX_TIMESTAMP('2026-06-01') or wrap it in FROM_UNIXTIME(column) to read a date from it. A column marked (date) is a real date: use it directly, and never put FROM_UNIXTIME around it.
Never write anything that changes data and never open a second query: no INSERT, UPDATE, DELETE, DROP, ALTER, CREATE, GRANT, UNION, and no second statement. Such an answer is refused.
Question:
--
$q
--
Models and their columns:
$struct
The current date and time is {{ date('Y-m-d H:i') }}.

<script>
const recognition = window.webkitSpeechRecognition ? new webkitSpeechRecognition : null
if (recognition){
	recognition.lang = obj('html').lang+'-'+obj('html').lang.toUpperCase()
	recognition.interimResults = true
	recognition.onresult = e => obj('#bi input').value = Array.from(e.results).map(result => result[0].transcript).join('')
	recognition.onend = e => obj('#bi input').value && obj('#bi').requestSubmit()
}
else app.mod.delete('#speak')
on('click', '#speak', () => recognition.start())
on('click', '#bi input', input => input.value = '')
on('change', '#bi input', input => (index = Array.from(searches.options).map(opt => opt.value).indexOf(input.value)) >= 0 && app.get(searches.options[index].dataset.uri))
</script>

<style>
form#bi {
	background: $surface
	border-radius: 9px
	display: flex
	margin: 1rem 0
	i: cursor: pointer
}
.bi-stat {
	background: $surface
	border-radius: 9px
	margin: 1rem 0
	padding: 2rem
	text-align: center
	.bi-stat-value {
		font-size: 3rem
		font-weight: 700
		line-height: 1.1
	}
	.bi-stat-label: opacity: .7
}
table.bi-table {
	border-collapse: collapse
	margin: 1rem 0
	width: 100%
	td {
		border-bottom: 1px solid #8884
		padding: .4rem .6rem
	}
	td:last-child {
		text-align: right
		font-variant-numeric: tabular-nums
	}
}
#widgets + table.bi-table: opacity: .6
</style>
