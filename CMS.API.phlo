route async POST api $record {
	if (!%CSRF->verify) return apply(error: 'Invalid CSRF token')
	if (!$this->model = CMS::uriRecordFind($record)) return false
	if (!$this->model::canCreate()) return apply(error: 'Not allowed')
	$this->record = phlo($this->model, ...array_intersect_key(%payload->objData, array_filter($this->fields, fn($f) => $this->writable($f))))
	$this->applySave && $this->renderRecord($this->model, $this->recordId)
}

route async POST api $record $id $fieldName {
	if (!%CSRF->verify) return apply(error: 'Invalid CSRF token')
	if (!($parent = CMS::uriRecordFind($record)) || !($field = $parent::fields()[$fieldName] ?? null) || $field->type !== 'child') return false
	if (!$parent::canView() || !$parent::record(...[$parent::idColumn() => $id])) return false
	$this->model = $field->obj
	if (!$this->model::canCreate()) return apply(error: 'Not allowed')
	$this->record = phlo($this->model, ...array_intersect_key(%payload->objData, array_filter($this->fields, fn($f) => $this->writable($f))), ...[$field->objKey($parent) => $id])
	$this->applySave && $this->renderChild($parent, $id, $fieldName, $this->recordId)
}

route async PUT api $record $id {
	if (!%CSRF->verify) return apply(error: 'Invalid CSRF token')
	if (!$this->model = CMS::uriRecordFind($record)) return false
	$this->id = $id
	$this->record = $this->model::record(...[$this->idColumn => $id])
	if (!$this->record) return false
	if (!$this->model::canChange($this->record)) return apply(error: 'Not allowed')
	$this->applySave && $this->renderRecord($this->model, $id)
}

route async PUT api $record $id $fieldName $childId {
	if (!%CSRF->verify) return apply(error: 'Invalid CSRF token')
	if (!($parent = CMS::uriRecordFind($record)) || !($field = $parent::fields()[$fieldName] ?? null) || $field->type !== 'child') return false
	$this->model = $field->obj
	$this->id = $childId
	$this->record = $this->model::record(...[$this->idColumn => $childId])
	if (!$this->record || !$field->objOwns($this->record, $id, $parent)) return false
	if (!$this->model::canChange($this->record)) return apply(error: 'Not allowed')
	$this->applySave && $this->renderChild($parent, $id, $fieldName, $childId)
}

route async PATCH api $model $id $fieldName {
	if (!%CSRF->verify) return apply(error: 'Invalid CSRF token')
	if (!in_array($model, %app->models) || !($field = $model::fields()[$fieldName] ?? null)) return false
	$this->model = $model
	$this->record = $model::record(...[$this->idColumn => $id])
	if (!$this->record) return false
	if (!$model::canChange($this->record)) return apply(error: 'Not allowed')
	$this->parsePayload($this->fieldsPatch($fieldName))
	$this->record->objSave
	$referer = parse_url((string)($_SERVER['HTTP_REFERER'] ?? void), PHP_URL_PATH)
	return apply(path: trim((string)($referer ?: slash.$model.slash.$id), slash))
}

route async DELETE api $record $id {
	if (!%CSRF->verify) return apply(error: 'Invalid CSRF token')
	if (!$model = CMS::uriRecordFind($record)) return false
	$this->model = $model
	$this->record = $model::record(...[$this->idColumn => $id])
	if (!$this->record) return false
	if (!$model::canDelete($this->record)) return apply(error: 'Not allowed')
	$model::delete($this->idColumn.'=?', $id)
	$this->renderList($model)
}

route async DELETE api $record $id $fieldName $childId {
	if (!%CSRF->verify) return apply(error: 'Invalid CSRF token')
	if (!($parent = CMS::uriRecordFind($record)) || !($field = $parent::fields()[$fieldName] ?? null) || $field->type !== 'child') return false
	$this->model = $field->obj
	$this->record = $this->model::record(...[$this->idColumn => $childId])
	if (!$this->record || !$field->objOwns($this->record, $id, $parent)) return false
	if (!$this->model::canDelete($this->record)) return apply(error: 'Not allowed')
	$field->obj::delete($this->idColumn.'=?', $childId)
	$this->renderRecord($parent, $id)
}

method renderRecord($model, $id, $replace = false){
	%app->active = $model
	$CMS = CMS($model, 'record', id: $id)
	if (!$CMS->record) return main(tag('section', tag('h1', en('Not found')).tag('p', en('This record no longer exists.'))), en('Not found'))
	return main($CMS, $CMS->title, path: ($model::$uriRecord ?? $model).slash.$id, pathReplace: $replace)
}

method renderList($model){
	%app->active = $model
	$CMS = CMS($model, 'list')
	return main($CMS, $CMS->title, path: $model::$uriList ?? $model::$table)
}

method renderChild($parent, $id, $fieldName, $childId){
	%app->active = $parent
	$CMS = CMS($parent, 'record', id: $id, childField: $fieldName, childId: $childId, childMode: 'record', hideBody: true)
	return main($CMS, $CMS->title, path: ($parent::$uriRecord ?? $parent).slash.$id.slash.$fieldName.slash.$childId)
}

method event($event, ...$args) => method_exists($this->model, $event) && $this->record->$event(...$args)
method fields => array_filter($this->model::fields(), fn($field) => !in_array($field->type, ['child', 'many', 'virtual']))
prop fieldsRequired => array_filter($this->fields, fn($field) => $field->required)
prop fieldsPatch($name) => array_filter($this->fields, fn($field) => $field->handle || $field->name === $name)

method checkRequired {
	$required = []
	foreach ($this->fieldsRequired AS $column => $field){
		$value = %payload->$column ?? $this->record->$column
		if ($value === null || $value === '') $required[] = $field
	}
	return $required ?: true
}

method parsePayload($fields) => loop($fields, [$this, 'parsePayloadField'])
method parsePayloadField($field, $column){
	if ($field->has('parse')){
		// Run a parser when the field manages its own value (handle: token, timestamps) or is writable;
		// a non-writable, non-handle parser (e.g. a change:false password) must not apply payload input.
		if ($field->handle || $this->writable($field)) $field->parse($this->record)
	}
	elseif ($this->writable($field) && %payload->hasData($column)) $this->record->$column = %payload->$column
}
method writable($field) => (%req->method === 'POST' ? $field->create : $field->change) !== false
method fieldsMany => array_filter($this->model::fields(), fn($field) => $field->type === 'many' && $this->writable($field))
prop idColumn => $this->model::idColumn()
prop recordId {
	$pk = $this->idColumn
	return $this->record->$pk
}
method syncMany => loop($this->fieldsMany, fn($field) => $field->sync($this->model, $this->recordId))

// A hand sorted model hides its sort column, so nothing fills it in. A new record would
// land on zero and jump to the front, and a record dragged into another group would keep a
// number that means nothing there and collide with whatever already holds it. Both get the
// next free position in the group they end up in.
method applySortPosition($old){
	if (!class_exists('CMS_list_sort')) return
	if ((property_exists($this->model, 'listView') ? $this->model::$listView : null) !== 'sort') return
	$column = CMS_list_sort::sortColumn($this->model)
	$group = CMS_list_sort::sortGroup($this->model)
	$value = $group === null ? null : ($this->record->$group ?? null)
	if (%req->method === 'POST'){
		if (!$this->record->hasData($column)) $this->record->$column = CMS_list_sort::sortNext($this->model, $value)
		return
	}
	if ($group === null || !$this->record->hasData($group)) return
	if ((string)$value === (string)CMS_list_sort::sortGroupOf($old, $group)) return
	$this->record->$column = CMS_list_sort::sortNext($this->model, $value)
}

method applySave {
	if (is_array($required = $this->checkRequired)){
		apply(class: [loop($required, fn($field) => "[name=\"$field->name\"]", ', ') => 'error'], error: 'Fill in all required fields')
		return false
	}
	$old = clone $this->record
	$this->parsePayload($this->fields)
	foreach ($this->model::fields() AS $column => $field){
		if ($field->type === 'many' && $this->record->hasData($column)) unset($this->record->$column)
	}
	$this->applySortPosition($old)
	if (%req->method === 'POST') $this->record = $this->model::create(...$this->record)
	if (%req->method === 'PUT'){
		$this->event('beforeSave', $old)
		$this->event('beforeChange', $old)
		$this->model::change($this->idColumn.'=?', $this->id, ...$this->record) && $this->record = $this->model::record(...[$this->idColumn => $this->id])
		$this->event('afterChange', $old)
		$this->event('afterSave', $old)
	}
	$this->syncMany
	return true
}
