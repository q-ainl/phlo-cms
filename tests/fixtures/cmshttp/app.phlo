static %model.DB => %SQLite(data.'test.db')

prop title = 'CMS HTTP test fixture'
prop models = ['post', 'locked', 'tagpk', 'hooked']
prop menu = []

static setup {
	post::prepareTable()
	locked::prepareTable()
	tagpk::prepareTable()
	hooked::prepareTable()
	return 'ok'
}

route GET csrf => view('ok')

if (!function_exists('en')) { function en($text, ...$args){ return $args ? sprintf($text, ...$args) : $text; } }

if (app::route()) return
return output(['error' => 'not found'], code: 404)

view head: %CSRF
